# Local development template. Copy to .env and keep real values out of git.
#
# NODE_ENV=production refuses to start until MONGO_URI, FRONTEND_ORIGIN, and
# a real AI_PROVIDER with AI_API_KEY are set. A production MONGO_URI must
# include a username, a password, and tls=true. This local URI is only for
# NODE_ENV=development.
#
# Production shape, with the password kept in the password manager:
#   mongodb://workforce_app:PASSWORD@127.0.0.1:27017/led-city-workforce-prod?authSource=led-city-workforce-prod&tls=true
#
# Labelled mock AI in production requires ALLOW_MOCK_AI=true.
# Build the frontend with VITE_API_BASE set to this API's public /api URL.
# Do not put secrets in a VITE_ variable.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/led-city-workforce-dev

# Generate your own secret locally and keep it in .env only. Do not commit a real value.
# PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
# Mac mini: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed by CORS. On the Mac mini this is the
# Tailscale origin of the frontend, not localhost.
FRONTEND_ORIGIN=http://localhost:5173

# Empty uses the default: mock in development, off in production.
# true forces mock drivers. Leave empty for local development.
MOCK_MODE=

# Assistant. The key stays in this file on the server.
# mock = labelled local answers, no network. Use this until a key exists.
# gemini | openai | anthropic call that provider. A missing or rejected key
# returns an error. It is not replaced with a mock answer.
# Gemini default model: gemini-3.8-flash
# OpenAI default model: gpt-5-mini
# Anthropic default model: claude-3-5-haiku-latest
# AI_FALLBACK_TO_MOCK covers a temporary provider outage only, and that
# answer is labelled [MOCK FALLBACK]. Set it to false on the Mac mini.
# ALLOW_MOCK_AI=true is the only way to boot production with AI_PROVIDER=mock.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=900
AI_TEMPERATURE=0.3
AI_DAILY_CALL_LIMIT=200
AI_ASK_RATE_LIMIT=40
AI_MONTHLY_BUDGET_USD=25
AI_FALLBACK_TO_MOCK=true
ALLOW_MOCK_AI=false

# Idle detection stays inside 15-20 minutes. Empty ACTIVITY_STALE_MINUTES
# uses the same window as IDLE_THRESHOLD_MINUTES.
IDLE_THRESHOLD_MINUTES=15
HEARTBEAT_SECONDS=60
ACTIVITY_STALE_MINUTES=

# Live view stays super-admin only until that role list is approved.
# Screenshots cannot be turned on. These values are the bootstrap defaults.
LIVEVIEW_ALLOWED_ROLES=SUPER_ADMIN
LIVEVIEW_EXCLUDE_REDUCED=true
LIVEVIEW_REQUIRE_APPROVAL=true
LIVEVIEW_FRAME_TTL_SECONDS=5
LIVEVIEW_MAX_FRAME_BYTES=400000
LIVEVIEW_MIN_FRAME_INTERVAL_MS=500
LIVEVIEW_REQUEST_TTL_SECONDS=90
LIVEVIEW_IDLE_TIMEOUT_SECONDS=120

# Account setup and password reset. A super admin copies a one-time link
# from Administration. Nothing is emailed while NOTIFY_DRIVER=mock.
# A real invitation requires NOTIFY_DRIVER=live plus SMTP or an HTTP mailbox.
# The link is not stored in the notification log.
# DIGEST_SEND_ENABLED=true is what lets the Friday digest actually leave the machine.
NOTIFY_DRIVER=mock
NOTIFY_ON_OVERRUN=false
DIGEST_TIMEZONE=America/Chicago
DIGEST_DAY_OF_WEEK=5
DIGEST_HOUR=17
DIGEST_MINUTE=0
OMAIR_WHATSAPP_NUMBER=
DIGEST_SEND_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
EMAIL_TRANSPORT=mock
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=

# Zoho, WorkDrive, and the CMS are not contacted while this is mock.
# Set live only after the code-review gate, and only with Omair's tokens.
INTEGRATIONS_DRIVER=mock
ZOHO_CRM_API_BASE=https://www.zohoapis.com/crm/v5
ZOHO_BOOKS_API_BASE=https://www.zohoapis.com/books/v3
ZOHO_INVENTORY_API_BASE=https://www.zohoapis.com/inventory/v1
ZOHO_ORG_ID=
ZOHO_ACCESS_TOKEN=
WORKDRIVE_API_BASE=https://www.zohoapis.com/workdrive/api/v1
WORKDRIVE_ACCESS_TOKEN=
CMS_API_BASE=
CMS_API_TOKEN=

# Retention deletes nothing until an administrator sets a period and approves it.
# Leave the day values empty. Zero is not an approved retention period.
RETENTION_ENABLED=false
RETENTION_ACTIVITY_DAYS=
RETENTION_LIVEVIEW_DAYS=
RETENTION_NOTIFICATION_DAYS=
RETENTION_AI_USAGE_DAYS=
RETENTION_PROPOSAL_DAYS=
RETENTION_INTEGRATION_DAYS=

# General API limit per 15 minutes, then the tighter login limit per 15 minutes.
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=10
